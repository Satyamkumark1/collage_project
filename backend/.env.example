# Copy to .env and fill in. .env is gitignored — never commit real secrets.

GROQ_API_KEY=
VOYAGE_API_KEY=

# HS512 needs a secret >= 64 bytes. Generate one with:
#   openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=

DB_URL=jdbc:postgresql://localhost:5432/studyflow_dev
DB_USER=
DB_PASSWORD=

STORAGE_LOCAL_ROOT=

# Must match frontend/vite.config.ts's dev server port.
CORS_ALLOWED_ORIGIN=http://localhost:5183
